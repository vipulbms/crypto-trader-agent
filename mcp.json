{
  "name": "Kryptos MCP Server",
  "description": "Read-only MCP HTTP query interface for the Kryptos agent.",
  "type": "http",
  "transport": "streamable-http",
  "url": "http://127.0.0.1:8092/mcp",
  "host": "127.0.0.1",
  "port": 8092,
  "mode": "paper",
  "start_command": "PYTHONPATH=. python src/mcp/server.py --mode paper",
